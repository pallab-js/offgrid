# OffGrid hub environment variables.
#
# The hub reads these from the process environment at startup — it does NOT
# auto-load this file. Copy it to .env (gitignored), edit, then either export
# the values in your shell or load the whole file in one line:
#
#     set -a; . ./.env; set +a
#
# Every value is optional; defaults are shown commented.

# --- Network ---------------------------------------------------------------
# TCP port for the hub (HTTP API + /ws WebSocket + the Next app).
PORT=3000
# Interface to bind. CAUTION: this is read from the environment variable
# HOSTNAME — if your system exports HOSTNAME (some shells/distros do), that
# value wins over the default and the hub may not be reachable from the LAN.
# Set it explicitly to an address, or unset it.
#HOSTNAME=0.0.0.0

# --- Storage ---------------------------------------------------------------
# Where the SQLite DB, uploaded files and logs live (created if missing).
#DATA_DIR=./data
# Per-file upload cap in bytes (default 512 MB).
#MAX_FILE_BYTES=536870912
# JSON request body cap in bytes.
#MAX_JSON_BODY=32768

# --- TLS (opt-in) ----------------------------------------------------------
# Serve https/wss instead of http/ws. The browser client follows the page
# protocol automatically, so no app-side config is needed. Without this the
# hub is cleartext on the wire — see "Security model" in the README.
# Self-signed certificates show a browser warning on every joining device
# unless you install your CA there.
#ENABLE_TLS=true
#TLS_CERT=/absolute/path/to/cert.pem
#TLS_KEY=/absolute/path/to/key.pem

# --- Logging ---------------------------------------------------------------
# One of: debug | info | warn | error (other values silence all output).
LOG_LEVEL=info

# --- Development only ------------------------------------------------------
# Extra browser origins accepted by `next dev` (comma-separated).
#ALLOWED_DEV_ORIGINS=http://192.168.1.20:3000
#NODE_ENV=development
